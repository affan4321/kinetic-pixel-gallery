# Cloudflare R2 Configuration (only needed for sync-work script)
# These are NOT required for the frontend to work
# The frontend fetches data from: https://videoassets.smaffan.com/metadata.json
# Add these in Vercel Project Settings > Environment Variables if you want to run sync-work
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET=muhammad-affan-video-editing